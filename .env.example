SITE_URL=http://localhost:3000
STRIPE_PRODUCT_ID=prod_...
STRIPE_PRICE_ID=price_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
ELEVENLABS_API_KEY=sk_...
NEWS_REFRESH_URL=https://your-editorial-pipeline.example/news/refresh
NEWS_REFRESH_TOKEN=replace_with_a_long_random_token
OWNER_EMAIL=you@example.com
# Baidu Netdisk (百度网盘) — serves per-lesson course transcripts. See the
# setup steps at the top of lib/baidu-netdisk.ts. Leave unset to disable the
# transcript feature entirely (the site degrades gracefully without it).
BAIDU_NETDISK_APP_KEY=
BAIDU_NETDISK_SECRET_KEY=
BAIDU_NETDISK_REFRESH_TOKEN=
BAIDU_NETDISK_TRANSCRIPT_DIR=/apps/baybimai/transcripts
